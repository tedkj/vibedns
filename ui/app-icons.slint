// VibeDNS's own icons, on the VibeWare 16-unit grid (1-unit strokes, 0/45/90 degrees,
// axis-aligned strokes on half units). The shared set lives in @vibeware.

export global AppIcons {
    // Query: a play mark, its slanted sides at 45 degrees.
    out property <string> play: "M 5.5 3.5 L 10.5 8.5 L 5.5 13.5 Z";
    // Trace: stairs down from the root.
    out property <string> trace: "M 1.5 3.5 L 5.5 3.5 L 5.5 7.5 L 9.5 7.5 L 9.5 11.5 L 13.5 11.5 M 11.5 9.5 L 13.5 11.5 L 11.5 13.5";
    // Flush the cache: a broom, its head a cut square, its handle at 45 degrees.
    out property <string> flush: "M 7.5 6.5 L 10.5 9.5 L 6.5 13.5 L 3.5 13.5 L 3.5 10.5 Z M 9 8 L 14.5 2.5 M 5.5 11.5 L 3.5 13.5 M 7.5 11.5 L 6.5 12.5";
}
